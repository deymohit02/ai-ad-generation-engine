############################################
# CORE PLATFORM
############################################
NODE_ENV=production
N8N_HOST=your-domain.com
N8N_PORT=5678
N8N_PROTOCOL=https
N8N_WEBHOOK_URL=https://your-domain.com/

############################################
# TELEGRAM BOT
############################################
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_WEBHOOK_SECRET=your-telegram-webhook-secret

############################################
# OPENAI (Speech + Ad Script)
############################################
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o
OPENAI_WHISPER_MODEL=whisper-1

############################################
# VEO 3 (fal.ai)
############################################
VEO3_API_KEY=your-veo3-api-key
VEO3_API_SECRET=your-veo3-api-secret
VEO3_ENDPOINT=https://queue.fal.run/fal-ai/veo3

############################################
# GOOGLE DRIVE (Video Storage)
############################################
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://your-domain.com/oauth2/callback
GOOGLE_DRIVE_FOLDER_ID=your-video-output-folder-id

############################################
# AIRTABLE (Scene Database)
############################################
AIRTABLE_API_KEY=your-airtable-personal-access-token
AIRTABLE_BASE_ID=your-airtable-base-id
AIRTABLE_TABLE_ID=your-airtable-table-id

############################################
# JSON2VIDEO (Final Movie Builder)
############################################
JSON2VIDEO_API_KEY=your-json2video-api-key
JSON2VIDEO_API_URL=https://api.json2video.com/v2/movies

############################################
# SECURITY
############################################
WEBHOOK_SHARED_SECRET=your-webhook-shared-secret
JWT_SECRET=your-jwt-secret
ENCRYPTION_KEY=your-encryption-key
